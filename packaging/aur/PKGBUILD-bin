# Maintainer: Derpedyea <derped@mineperial.com>
pkgname=dictationapp-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Wispr Flow-style push-to-talk dictation for Wayland/niri (prebuilt binary)"
arch=('x86_64')
url="https://github.com/Derpedyea/niri-wispr"
license=('MIT' 'Apache-2.0')
provides=('dictationapp')
conflicts=('dictationapp')
depends=(
  'glibc'
  'gcc-libs'
  'alsa-lib'
  'libxcb'
  'libxau'
  'libxdmcp'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
  'fontconfig'
  'wl-clipboard'
)
optdepends=(
  'pipewire: audio cues via pw-play'
  'libpulse: audio cues via paplay'
  'alsa-utils: audio cues via aplay'
)
source=("dictationapp-v$pkgver-x86_64-linux-gnu.tar.gz::https://github.com/Derpedyea/niri-wispr/releases/download/v$pkgver/dictationapp-v$pkgver-x86_64-linux-gnu.tar.gz")
sha256sums=('SKIP')
# The UI is a Bun single-file executable; stripping it removes the app.
options=('!strip')

package() {
  install -Dm755 dictationapp "$pkgdir/usr/bin/dictationapp"
  install -Dm644 packaging/dictationapp-settings.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm755 dictationapp-ui -t "$pkgdir/usr/lib/dictationapp/"
  install -Dm644 ui/node_modules/@gpuix/native/LICENSE "$pkgdir/usr/share/licenses/$pkgname/GPUIX-LICENSE-APACHE"
}
