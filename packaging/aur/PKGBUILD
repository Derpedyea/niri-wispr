# Maintainer: Derpedyea <derped@mineperial.com>
pkgname=dictationapp
pkgver=0.2.0
pkgrel=1
pkgdesc="Wispr Flow-style push-to-talk dictation for Wayland/niri"
arch=('x86_64')
url="https://github.com/Derpedyea/niri-wispr"
license=('MIT' 'Apache-2.0')
depends=(
  'glibc'
  'gcc-libs'
  'alsa-lib'
  'libxcb'
  'libxau'
  'libxdmcp'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
  'fontconfig'
  'wl-clipboard'
)
makedepends=('cargo' 'pkgconf' 'bun')
optdepends=(
  'pipewire: audio cues via pw-play'
  'libpulse: audio cues via paplay'
  'alsa-utils: audio cues via aplay'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/Derpedyea/niri-wispr/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
# The UI is a Bun single-file executable; stripping it removes the app.
options=('!strip')

build() {
  # The GitHub source tarball extracts to the repo name, not the package name.
  cd "niri-wispr-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
  cd ui
  bun install --frozen-lockfile
  bun run build
}

package() {
  cd "niri-wispr-$pkgver"
  install -Dm755 target/release/dictationapp "$pkgdir/usr/bin/dictationapp"
  install -Dm644 packaging/dictationapp-settings.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm755 target/release/dictationapp-ui -t "$pkgdir/usr/lib/dictationapp/"
  install -Dm644 ui/node_modules/@gpuix/native/LICENSE "$pkgdir/usr/share/licenses/$pkgname/GPUIX-LICENSE-APACHE"
}
